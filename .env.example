# Copy to .env for local configuration. Keep the dashboard loopback-only.
MCDASH_BIND_HOST=127.0.0.1
MCDASH_PORT=8000

# Set this to the one server directory the dashboard may inspect.
# Leave empty until configured. File reads must remain inside this directory.
MCDASH_SERVER_DIR=

# Java Edition status query target. Keep local unless you deliberately configure a remote server.
MCDASH_SERVER_HOST=127.0.0.1
MCDASH_SERVER_PORT=25565
MCDASH_SERVER_NAME=
MCDASH_SERVER_TYPE=unknown

# Relative to MCDASH_SERVER_DIR. The dashboard reads a bounded tail only.
MCDASH_LOG_PATH=logs/latest.log

# Runtime database path; database files are excluded from Git.
MCDASH_DB_PATH=backend/data/dashboard.sqlite3
